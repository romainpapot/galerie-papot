generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite ne gère pas les enums Prisma : le statut est stocké en String
// et validé côté application (voir src/lib/status.ts).
model Artwork {
  id               Int            @id @default(autoincrement())
  slug             String         @unique
  title            String
  description      String         @default("")
  // Version anglaise (facultative : à défaut, le texte français est affiché)
  titleEn          String         @default("") @map("title_en")
  descriptionEn    String         @default("") @map("description_en")
  // Valeurs choisies dans les listes gérées en back-office (voir ListOption)
  mediumId         Int?           @map("medium_id")
  medium           ListOption?    @relation("ArtworkMedium", fields: [mediumId], references: [id], onDelete: Restrict)
  supportId        Int?           @map("support_id")
  support          ListOption?    @relation("ArtworkSupport", fields: [supportId], references: [id], onDelete: Restrict)
  dimensionsId     Int?           @map("dimensions_id")
  dimensions       ListOption?    @relation("ArtworkDimensions", fields: [dimensionsId], references: [id], onDelete: Restrict)
  // Anciens champs en texte libre, repris dans les listes par `npm run db:migrer-listes`.
  // Plus utilisés par le site : à supprimer une fois la production migrée.
  legacyMedium     String         @default("") @map("medium")
  legacySupport    String         @default("") @map("support")
  legacyMediumEn   String         @default("") @map("medium_en")
  legacySupportEn  String         @default("") @map("support_en")
  legacyDimensions String         @default("") @map("dimensions")
  price            Float?
  themeId          Int?           @map("theme_id")
  theme            Theme?         @relation(fields: [themeId], references: [id], onDelete: Restrict)
  artistId         Int?           @map("artist_id")
  artist           Artist?        @relation(fields: [artistId], references: [id], onDelete: Restrict)
  imageUrl         String         @default("") @map("image_url")
  images           ArtworkImage[]
  isNew            Boolean        @default(false) @map("is_new")
  status           String         @default("DISPONIBLE")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  inquiries        Inquiry[]
  pageViews        PageView[]

  @@index([status])
  @@index([themeId])
  @@index([artistId])
  @@map("artworks")
}

// Images complémentaires (l'image principale est Artwork.imageUrl)
model ArtworkImage {
  id        Int     @id @default(autoincrement())
  artworkId Int     @map("artwork_id")
  artwork   Artwork @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  url       String
  position  Int     @default(0)

  @@map("artwork_images")
}

model Theme {
  id       Int       @id @default(autoincrement())
  name     String
  nameEn   String    @default("") @map("name_en")
  slug     String    @unique
  artworks Artwork[]

  @@map("themes")
}

model Artist {
  id       Int       @id @default(autoincrement())
  name     String
  slug     String    @unique
  artworks Artwork[]

  @@map("artists")
}

// Valeurs des listes déroulantes du formulaire d'œuvre, pour un nommage identique
// d'une œuvre à l'autre. `kind` : MEDIUM, SUPPORT ou DIMENSIONS (src/lib/options.ts).
model ListOption {
  id           Int       @id @default(autoincrement())
  kind         String
  name         String
  nameEn       String    @default("") @map("name_en")
  mediumOf     Artwork[] @relation("ArtworkMedium")
  supportOf    Artwork[] @relation("ArtworkSupport")
  dimensionsOf Artwork[] @relation("ArtworkDimensions")

  @@unique([kind, name])
  @@map("list_options")
}

model Inquiry {
  id           Int      @id @default(autoincrement())
  artworkId    Int?     @map("artwork_id")
  artwork      Artwork? @relation(fields: [artworkId], references: [id], onDelete: SetNull)
  visitorName  String   @map("visitor_name")
  visitorEmail String   @map("visitor_email")
  visitorPhone String   @default("") @map("visitor_phone")
  message      String
  locale       String   @default("fr") // langue du site lors de l'envoi
  isRead       Boolean  @default(false) @map("is_read")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("inquiries")
}

// Mesure d'audience interne, sans cookie : le visiteur est une empreinte anonyme
// (IP + navigateur hachés avec un sel renouvelé chaque jour), voir src/lib/analytics.ts.
model PageView {
  id        String   @id // identifiant généré par le navigateur, sert à enregistrer la durée
  path      String
  artworkId Int?     @map("artwork_id")
  artwork   Artwork? @relation(fields: [artworkId], references: [id], onDelete: SetNull)
  visitorId String   @map("visitor_id")
  source    String   @default("Accès direct")
  device    String   @default("Ordinateur")
  duration  Int? // secondes passées sur la page (onglet visible)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([artworkId])
  @@map("page_views")
}

model AdminUser {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("admin_users")
}
