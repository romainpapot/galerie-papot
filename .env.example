# Base de données SQLite (chemin relatif au dossier prisma/)
DATABASE_URL="file:./dev.db"

# Secret de signature des sessions admin (32 caractères minimum).
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="remplacez-moi-par-une-longue-chaine-aleatoire-de-32-caracteres"

# Compte administrateur créé par `npm run db:seed`
ADMIN_USERNAME="galerie"
ADMIN_PASSWORD="changez-ce-mot-de-passe"

# Dossier de stockage des images envoyées depuis le back-office
UPLOAD_DIR="./uploads"

# URL publique du site (utilisée dans les emails)
SITE_URL="http://localhost:3000"

# Notifications email au galeriste (laisser SMTP_HOST vide : les emails sont
# simplement affichés dans la console du serveur)
GALLERY_EMAIL="contact@galerie-papot.fr"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Galerie Papot <no-reply@galerie-papot.fr>"
